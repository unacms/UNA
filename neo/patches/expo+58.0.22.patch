+/**
+ * After a socket that had connected drops, open a new one with a growing delay. Returns false when
+ * HMR is already unavailable for another reason, the socket never connected, or the attempts ran out.
+ */
+function scheduleReconnect(client: MetroHMRClient): boolean {
+  if (client !== hmrClient) return true; // an old socket's late event
+  if (hmrUnavailableReason !== null || !didConnect) return false;
+  if (reconnectTimer !== null) return true;
+  if (reconnectAttempt >= RECONNECT_ATTEMPTS) return false;
+  reconnectAttempt += 1;
+  reconnectTimer = setTimeout(() => {
+    reconnectTimer = null;
+    connectClient();
+  }, Math.min(1000 * reconnectAttempt, 5000));
+  return true;
+}
