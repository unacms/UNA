{
  "name": "solito-expo-router",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/react": "~18.3.12",
    "eslint": "^9.28.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "lerna-update-wizard": "^1.1.2",
    "turbo": "^1.4.2",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "native": "cd apps/expo && dotenv -e ../../.env.local -- expo start --clear",
    "ios": "cd apps/expo && dotenv -e ../../.env.local -- yarn ios",
    "ios:device": "cd apps/expo && dotenv -e ../../.env.local -- npx expo run:ios --device",
    "android": "cd apps/expo && dotenv -e ../../.env.local -- npx expo run:android",
    "web": "cd apps/next && dotenv -e ../../.env.local -- yarn dev",
    "build": "cd apps/next && dotenv -e ../../.env.local -- yarn build",
    "prod": "cd apps/next && dotenv -e ../../.env.local -- yarn start",
    "prod:pm2": "cd apps/next && dotenv -e ../../.env.local -- yarn start:pm2",
    "analyze": "cd apps/next && cross-env ANALYZE=true yarn build",
    "clean": "rm -rf ./node_modules && rm -rf ./apps/expo/node_modules && rm -rf ./apps/next/node_modules && rm -rf ./packages/app/node_modules"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  "dependencies": {
    "cheerio": "^1.0.0",
    "dom-serializer": "^2.0.0",
    "dotenv-cli": "^7.0.0",
    "expo-blur": "^14.1.4",
    "htmlparser2": "^10.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
