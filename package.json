{
  "name": "solito-expo-router",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/react": "^18.0.17",
    "@types/react-native": "^0.69.5",
    "eslint": "^8.21.0",
    "turbo": "^1.4.2",
    "typescript": "^4.7.4"
  },
  "scripts": {
    "native": "cd apps/expo && dotenv -e ../../.env.local -- expo start --clear",
    "ios": "cd apps/expo && dotenv -e ../../.env.local -- npx expo run:ios",
    "android": "cd apps/expo && dotenv -e ../../.env.local -- npx expo run:android",
    "web": "cd apps/next && dotenv -e ../../.env.local -- yarn next",
    "clean": "rm -rf ./node_modules && rm -rf ./apps/expo/node_modules && rm -rf ./apps/next/node_modules && rm -rf ./packages/app/node_modules"
  },
  "resolutions": {
    "metro": "^0.73.1",
    "metro-resolver": "^0.73.1"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  
  "dependencies": {
    "dotenv-cli": "^7.0.0"
  }

}
