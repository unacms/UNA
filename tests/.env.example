# Copy to tests/.env to override. tests/.env is gitignored.
# Admin matches install/cmd.php defaults (php cmd.php).
# Regular user is not created by the installer. CI seeds it after install.
# A local install skips those cases until the account exists.
UNA_TEST_ADMIN_EMAIL=admin@example.com
UNA_TEST_ADMIN_PASSWORD=unauna
UNA_TEST_USER_EMAIL=user@example.com
UNA_TEST_USER_PASSWORD=unauna
# API v2 tests (tests/integration/api/ApiV2*) make the people and groups they act as and remove
# them afterwards. Set this to act as the user above and use the site's own people and groups
# where it has them (what a test leaves then stays in that user's feed and uploads).
# UNA_TEST_SITE_DATA=1
