<?xml version="1.0" encoding="UTF-8"?>
<!-- UNA-Migration-Min-System-Version: 15.0.0-RC4 -->
<!-- The welcome letter in the new email layout: a title, a short text, a button to the site and a help line. -->
<resources name="ru" flag="ru" title="Russian" category="System">
    <string_upd name="_sys_et_txt_body_welcome"><![CDATA[{email_header}
<h1 class="bx-email-title" style="margin:0 0 20px 0; font:600 28px/1.3 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; letter-spacing:-0.084px; color:#14171e; text-align:center;">Добро пожаловать, {name}!</h1>
<p style="margin:0 auto 32px auto; max-width:380px; font:400 16px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; letter-spacing:-0.048px; color:#43454b; text-align:center;">Вы подтвердили свой профиль, и он готов к работе.<br />Добро пожаловать в {site_name}.</p>
<table align="center" border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin:0 auto 24px auto;">
<tbody><tr><td align="center" bgcolor="#14171e" style="background-color:#14171e; border-radius:8px;">
<a href="{site_url}" target="_blank" class="bx-email-btn" style="display:inline-block; background-color:#14171e; color:#ffffff; text-decoration:none; font:400 16px/24px -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; border-radius:8px; padding:16px 28px;">Открыть {site_name}</a>
</td></tr></tbody>
</table>
<p class="bx-email-muted" style="margin:32px auto 0 auto; max-width:400px; font:400 13px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color:#7b7d81; text-align:center;">Если понадобится помощь, свяжитесь с нами.</p>
{email_footer}]]></string_upd>
</resources>
