<!-- Studio > Designer > Settings > Corners: the corner size and smooth corners of the site and Studio. -->
<resources name="ru" flag="ru" title="Russian" category="System">
    <string_add name="_adm_dsg_txt_settings_section_corners"><![CDATA[Углы]]></string_add>
    <string_add name="_adm_dsg_inf_settings_section_corners"><![CDATA[Насколько скруглены углы блоков, кнопок, полей и всплывающих окон на сайте и в Студии. Капсулы и круги сохраняют форму.]]></string_add>
    <string_add name="_adm_stg_cpt_option_sys_design_radius"><![CDATA[Размер скругления]]></string_add>
    <string_add name="_adm_dsg_txt_settings_radius_large"><![CDATA[Большой]]></string_add>
    <string_add name="_adm_dsg_txt_settings_radius_small"><![CDATA[Маленький]]></string_add>
    <string_add name="_adm_dsg_txt_settings_radius_none"><![CDATA[Без скругления]]></string_add>
    <string_add name="_adm_stg_cpt_option_sys_design_radius_smooth"><![CDATA[Плавные углы]]></string_add>
    <string_add name="_adm_dsg_inf_settings_radius_smooth"><![CDATA[Рисует углы плавной кривой в браузерах, которые это поддерживают, например в Chrome. В остальных углы остаются круглыми.]]></string_add>
    <string_add name="_adm_stg_cpt_option_sys_design_radius_smooth_factor"><![CDATA[Множитель плавных углов]]></string_add>
    <string_add name="_adm_dsg_inf_settings_radius_smooth_factor"><![CDATA[Плавный угол выглядит меньше круглого того же радиуса. Там, где углы плавные, радиусы умножаются на это число, от 1 до 2.]]></string_add>
</resources>
