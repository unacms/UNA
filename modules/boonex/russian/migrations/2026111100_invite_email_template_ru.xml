<?xml version="1.0" encoding="utf-8"?>
<!-- UNA-Migration-Min-System-Version: 15.0.0-RC4 -->
<!-- Russian strings of the invitations module: new layout of the invitation email. -->
<resources name="ru" flag="ru" title="Russian" category="Invitations">
	<string_upd name="_bx_invites_et_invite_form_message_subject"><![CDATA[{profile_name} приглашает вас в {site_name}]]></string_upd>
	<string_upd name="_bx_invites_et_invite_form_message_body"><![CDATA[{email_header}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2328;">
  <tr>
    <td style="padding:8px 0 16px;">
      <p style="margin:0;font-size:22px;line-height:1.3;font-weight:600;">{profile_name} приглашает вас в <a href="{site_url}" style="color:#1f2328;text-decoration:none;">{site_name}</a></p>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 6px;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:#57606a;">Сообщение от {profile_name}</td>
  </tr>
  <tr>
    <td style="padding:16px 20px;background:#f6f8fa;border-radius:12px;font-size:15px;line-height:1.6;">
      <p style="margin:0;">{text}</p>
    </td>
  </tr>
  <tr>
    <td align="left" style="padding:28px 0 12px;">
      <a href="{join_url}" style="display:inline-block;padding:12px 28px;background:#1f2328;color:#ffffff;font-size:15px;font-weight:600;text-decoration:none;border-radius:999px;">Принять приглашение</a>
    </td>
  </tr>
  <tr>
    <td style="padding:8px 0 0;font-size:14px;line-height:1.6;color:#6e7781;">
      Если кнопка не работает, скопируйте ссылку в браузер:<br />
      <a href="{join_url}" style="color:#0969da;word-break:break-all;">{join_url}</a>
    </td>
  </tr>
</table>
{email_footer}]]></string_upd>
</resources>
