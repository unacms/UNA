	<string name="_bx_cidaascon_information_block"><![CDATA[
        <p>This module logs users in through the Cidaas hosted login page using the official <a target="_blank" href="https://github.com/cidaas/cidaas-sdk-php">Cidaas PHP SDK</a>.</p>
        <p>Create an application in your Cidaas tenant and set:</p>
        <ul>
            <li>Redirect URL: <strong>{0}</strong></li>
            <li>Base URL: your Cidaas instance, e.g. https://yourtenant.cidaas.de</li>
            <li>Client ID issued for that application</li>
            <li>Client Secret — required unless PKCE is enabled for a public client</li>
        </ul>
        <p>Enable PKCE in module settings if the Cidaas app is configured for the PKCE authorization code flow. With PKCE, Client Secret can be left empty. For more info see <a target="_blank" href="https://docs.cidaas.com/">Cidaas documentation</a>.</p>
        ]]></string>
	<string name="_bx_cidaascon_profile_error_api_keys"><![CDATA[Please configure the module in admin panel (Base URL and Client ID are required; Client Secret is required unless PKCE is enabled)]]></string>
