	<string name="_bx_analytics_adm_stg_inf_exclude_paths"><![CDATA[Path prefixes, or patterns with * (for example /page/*-admin), separated by commas or spaces.]]></string>
	<string name="_bx_analytics_adm_stg_inf_geo_source"><![CDATA[CDN headers: the country that Cloudflare, Vercel or CloudFront add to each request, and the region and city on Vercel.]]></string>
	<string name="_bx_analytics_adm_stg_inf_identity"><![CDATA[Cookieless: a hash of the address and browser that changes daily, with nothing stored on the device. A guest who comes back another day counts as a new visitor. Persistent: a random id kept in the browser or app, which allows guest retention but may need consent.]]></string>
	<string name="_bx_analytics_adm_stg_inf_ignore_params"><![CDATA[Left out of stored page paths, so one page is not counted as many. Separate with commas; * matches any characters. Campaign tags and ad click ids are always left out.]]></string>
	<string name="_bx_analytics_adm_stg_inf_link_members"><![CDATA[Record the profile of signed-in members, for member sessions and retention. Deleting a profile unlinks its visits.]]></string>
	<string name="_bx_analytics_adm_stg_inf_online_window"><![CDATA[Visitors active within this time count as online.]]></string>
	<string name="_bx_analytics_adm_stg_inf_platforms"><![CDATA[Clients whose visits are recorded.]]></string>
	<string name="_bx_analytics_adm_stg_inf_respect_dnt"><![CDATA[Skip browsers that send Do Not Track or Global Privacy Control.]]></string>
	<string name="_bx_analytics_adm_stg_inf_retention_days"><![CDATA[Older visits and events are deleted every hour.]]></string>
	<string name="_bx_analytics_adm_stg_inf_session_timeout"><![CDATA[A visit ends after this long without activity.]]></string>
	<string name="_bx_analytics_adm_stg_inf_track_bots"><![CDATA[Search engines, AI crawlers, AI assistants fetching pages, link previews, monitors and scripts. They are counted per day and page, apart from visitors.]]></string>
	<string name="_bx_analytics_adm_stg_inf_tracking"><![CDATA[Off stops collecting. Reports keep the data already collected.]]></string>
	<string name="_bx_analytics_adm_stg_inf_trusted_proxies"><![CDATA[Addresses or CIDR ranges of proxies and load balancers whose X-Forwarded-For header holds the visitor's address. Private network addresses and the NEO server are always trusted.]]></string>
