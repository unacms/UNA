	<string_add name="_adm_stg_inf_option_sys_sounds_buttons"><![CDATA[Submit and other buttons. In the apps, buttons answer with haptics only.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_choices"><![CDATA[Tabs, menu items, switches, checkboxes, radio buttons.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_level"><![CDATA[Everyone can pick Full, Quiet or Off for themselves: in the account menu on the site and in Studio, in the footer and the dashboard of the apps.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_menus"><![CDATA[Menus, popups, drawers and sections opening and closing.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_navigation"><![CDATA[The apps' tab bar and back buttons, opening Studio apps.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_notifications"><![CDATA[New notifications, messages and requests.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_platforms"><![CDATA[Short sounds when people press, open, save and get notified. Where a platform is off, nobody hears them there. The apps pick up changes with the next page they load.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_reactions"><![CDATA[Likes, reactions, ratings, favorites, follows.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_results"><![CDATA[Saved, posted or sent; refused with an error.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_set"><![CDATA[Glass is warm and calm. Mechanical is dry and precise. Bubble is playful. Press feels like a trackpad and rings longer. Each choice plays as you pick it.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_sounds_volume"><![CDATA[Quiet plays at 40% of it.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_vote_reactions_default"><![CDATA[Given with a single click or tap; other reactions are a hover or long press away. With none, the reaction button always opens the choice of reactions.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_vote_reactions_mode"><![CDATA[Solo: one reaction, the default one, given with a click. Few: a short list of reactions to choose from. Many: any emoji, chosen in an emoji picker.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_vote_reactions_per_user"><![CDATA[How many different reactions one person may give to the same content. Works in the Few and Many modes.]]></string_add>
	<string_add name="_adm_stg_inf_option_sys_vote_reactions_split_counters"><![CDATA[Show a separate counter for each reaction instead of one total.]]></string_add>
